import csv
import os
import random
from datetime import datetime, timedelta
from faker import Faker # Note: keep your original import casing if working locally

os.makedirs("data", exist_ok=True)

fake = Faker("en_US")

categories = [
    "Electronics",
    "Home Appliances",
    "Furniture",
    "Clothing",
    "Books"
]

products = [
    "Laptop", "Mouse", "Keyboard", "Monitor", "Printer",
    "Tablet", "Camera", "Chair", "Table", "Sofa",
    "T-Shirt", "Jeans", "Jacket", "Book", "Speaker"
]

product_prices = {}  

# 1. Generate Products
with open("data/products.csv", "w", newline="", encoding="utf-8") as file:
    writer = csv.writer(file)
    writer.writerow(["ProductID", "ProductName", "Category", "Price", "Stock"])

    for i in range(1, 101):
        price = random.randint(10, 1000)
        product_prices[i] = price
        writer.writerow([
            i,
            random.choice(products),
            random.choice(categories),
            price,
            random.randint(5, 200)
        ])

print("products.csv created successfully")

# 2. Generate Customers
with open("data/customers.csv", "w", newline="", encoding="utf-8") as file:
    writer = csv.writer(file)
    writer.writerow(["CustomerID", "Name", "Email", "Phone"])

    for i in range(1, 101):
        writer.writerow([
            i,
            fake.name(),
            fake.email(),
            fake.msisdn()[:10]
        ])

print("customers.csv created successfully")

start_date = datetime(2025, 1, 1)

# 3. Generate Orders
with open("data/orders.csv", "w", newline="", encoding="utf-8") as file:
    writer = csv.writer(file)
    writer.writerow(["OrderID", "CustomerID", "productID", "Quantity", "Order Date", "TotalAmount"])

    for order_id in range(1, 101):
        customer_id = random.randint(1, 100)
        product_id = random.randint(1, 100)
        quantity = random.randint(1, 5)
        
        total_amount = product_prices[product_id] * quantity
        
        random_days = random.randint(0, 365)
        order_date = (start_date + timedelta(days=random_days)).strftime("%Y-%m-%d")

        writer.writerow([
            order_id,
            customer_id,
            product_id,
            quantity,
            order_date,
            total_amount
        ])

print("orders.csv created successfully")


# 4. Function to Generate finance.csv
def generate_finance_csv(orders_path="data/orders.csv", output_path="data/finance.csv"):
    finance_rows = [["Date", "Description", "Category", "Amount", "Type"]]
    
    # Read orders to pull Income records
    with open(orders_path, "r", encoding="utf-8") as file:
        reader = csv.DictReader(file)
        for row in reader:
            finance_rows.append([
                row["Order Date"],
                f"Order #{row['OrderID']} Sale",
                "Sales Revenue",
                row["TotalAmount"],
                "Income"
            ])
            
    # Add some mock recurring expenses over the same year
    expense_categories = ["Software Subscription", "Office Rent", "Shipping & Logistics", "Marketing"]
    for _ in range(25): # Add 25 random expense items
        random_days = random.randint(0, 365)
        expense_date = (start_date + timedelta(days=random_days)).strftime("%Y-%m-%d")
        category = random.choice(expense_categories)
        amount = round(random.uniform(50.0, 1200.0), 2)
        
        finance_rows.append([
            expense_date,
            f"Monthly {category} Expense",
            category,
            amount,
            "Expense"
        ])
        
    # Sort transactions chronologically by Date
    header = finance_rows[0]
    data_rows = sorted(finance_rows[1:], key=lambda x: x[0])
    
    # Write out to finance.csv
    with open(output_path, "w", newline="", encoding="utf-8") as file:
        writer = csv.writer(file)
        writer.writerow(header)
        writer.writerows(data_rows)
        
    print("finance.csv created successfully")

# Execute the finance generator function
generate_finance_csv()
